{
  "name": "dorje-sherpa-dashboard",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-data.mjs && next dev",
    "build": "node scripts/prepare-data.mjs && node scripts/build-api.mjs && next build",
    "preview": "pnpm build && esbuild scripts/dev-server.ts --bundle --platform=node --format=esm --outfile=.preview/dev-server.mjs --external:./api/* --packages=external && ASK_MOCK=1 node .preview/dev-server.mjs",
    "preview:live": "esbuild scripts/dev-server.ts --bundle --platform=node --format=esm --outfile=.preview/dev-server.mjs --external:./api/* --packages=external && node .preview/dev-server.mjs",
    "data:prepare": "node scripts/prepare-data.mjs",
    "refresh": "bash refresh/refresh.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "deploy:stage": "python3 scripts/stage_deploy.py",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build:api": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.174",
    "ai": "^7.0.170",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
