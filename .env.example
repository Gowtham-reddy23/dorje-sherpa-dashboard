# Dorje Sherpa — environment variables. Copy to .env (git-ignored) and fill in:  cp .env.example .env
# NEVER commit .env, never paste these values into chat, Slack or GitHub. Details for each: docs/SETUP.md.
# Everything below is OPTIONAL for a first look: with nothing set, the app runs on fabricated SAMPLE data (passcode: sherpa-demo).

# ---------- Dashboard access ----------
# Passcode that encrypts the dashboard data and unlocks it in the browser. Choose a long random phrase; share it privately.
DASH_PASSCODE=
# 32+ random characters for signing the Ask Dorje login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# ---------- Ask Dorje (AI chat) ----------
# On Vercel, AI Gateway authenticates with the project's OIDC token automatically (no key needed) once a card is on the
# Vercel account (Vercel dashboard -> AI Gateway). For running Ask Dorje on your own computer, create a key in
# Vercel dashboard -> AI Gateway -> API Keys, or run `vercel env pull` to get a short-lived VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
# Model for Ask Dorje (Vercel AI Gateway model id). Default: anthropic/claude-sonnet-5.5 (fallback openai/gpt-6.1-sol).
ASK_DORJE_MODEL=
# Optional: where the chat function fetches /data.enc.json from (defaults to the site's own origin).
ASK_DATA_ORIGIN=

# ---------- Shopify (read-only) ----------
# Preferred: the official Shopify connector in Claude (no token here). See docs/SETUP.md -> Shopify.
# Fallback direct Admin API (read-only custom app, scopes read_orders, read_products, read_customers, read_reports, read_checkouts):
SHOPIFY_STORE_DOMAIN=dorjeteas.myshopify.com
# Admin API access token of that custom app (starts with shpat_). Shopify admin -> Settings -> Apps -> Develop apps.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# ---------- Meta Ads (read-only) ----------
# Long-lived token with ads_read from your Meta app (developers.facebook.com -> your app -> Graph API Explorer / System User).
META_ACCESS_TOKEN=
# Ad account id with the act_ prefix (Meta Ads Manager -> account dropdown). Placeholder below; put Dorje's real id in .env.
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX
META_API_VERSION=v21.0

# ---------- Zoko WhatsApp (read-only, GET only) ----------
# Zoko dashboard -> Settings -> API / Integrations -> API key. Used with header `apikey` on https://chat.zoko.io/v2
ZOKO_API_KEY=

# ---------- Google Ads (read-only; production access PENDING: Explorer access was refused on 24 Nov 2026) ----------
# Google Cloud project that has the Google Ads API enabled AND Explorer (or Basic) access approved.
GOOGLE_CLOUD_PROJECT=
# Path to the Application Default Credentials JSON created by `gcloud auth application-default login ...` (outside this repo).
GOOGLE_APPLICATION_CREDENTIALS=
# 10-digit Google Ads customer id, no dashes.
GOOGLE_ADS_CUSTOMER_ID=
# Only if you use a manager (MCC) account: its 10-digit id, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Fallback until API access is approved: Google Sheet id of the scheduled Google Ads report (Google Ads -> Reports -> Schedule -> Sheets).
GOOGLE_ADS_REPORT_SHEET_ID=

# ---------- Vercel (deploying your own copy) ----------
# Not needed if you use the Vercel CLI login (`vercel login`) or the official Vercel MCP (OAuth in Claude).
VERCEL_TOKEN=

# ---------- Competitor scans (optional, weekly) ----------
# Chrome used by the headless competitor scripts. macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=
# Scratch folder for browser screenshots/logs.
SHOT_DIR=/tmp/dorje-shot
